# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# web  = Claude searches the web for the person and company (best emails, costs web-search fees)
# site = only reads the company homepage (cheaper)
RESEARCH_MODE=web
EMAIL_LANGUAGE=English

# --- You and your offer (used in every email) ------------------------------
SENDER_NAME=Min Park
SENDER_TITLE=Founder
SENDER_COMPANY=ShipFast
SENDER_EMAIL=min@shipfast.io
VALUE_PROP=We cut e-commerce delivery costs 20-30% by routing orders across 40 carriers automatically. Used by 120+ online brands.
BOOKING_LINK=https://cal.com/min/20min
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx
OPT_OUT_LINE=If this isn't relevant, just reply "no thanks" and I won't follow up.

# --- Email (Gmail: turn on 2-step verification and create an App Password) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=min@shipfast.io
SMTP_PASSWORD=your-app-password
IMAP_HOST=imap.gmail.com
SEND_CALENDAR_INVITES=true
DAILY_SEND_LIMIT=40

# --- Cadence --------------------------------------------------------------
TIMEZONE=Asia/Seoul
FOLLOWUP_INTERVALS=3,4
CALL_AFTER_DAYS=2
FOLLOWUP_TIME=09:00
DAILY_REPORT_TIME=18:00
WORKDAYS=mon-fri

# --- Slack ------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C0123456789

# --- Dashboard ------------------------------------------------------------
DB_PATH=sales.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_TOKEN=
