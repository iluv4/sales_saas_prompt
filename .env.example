# 이 파일을 .env 로 복사해서 값을 채우세요 (로컬 실행용).
# Railway 같은 서버에 배포할 때는 이 파일 대신 서비스의 Variables 화면에 같은 이름으로 넣습니다.

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# web  = Claude가 사람과 회사를 웹 검색 (이메일 품질 최고, 검색 비용 발생)
# site = 회사 홈페이지만 읽음 (저렴)
RESEARCH_MODE=web
EMAIL_LANGUAGE=Korean

# --- 보내는 사람과 우리 회사 (모든 이메일의 기초) -----------------------------
SENDER_NAME=박민
SENDER_TITLE=대표
SENDER_COMPANY=ShipFast
SENDER_EMAIL=min@shipfast.io
VALUE_PROP=주문마다 40개 배송사 중 가장 저렴한 경로를 자동으로 골라 쇼핑몰 배송비를 20~30% 줄여 줍니다. 온라인 브랜드 120곳 이상이 사용 중입니다.
BOOKING_LINK=https://cal.com/min/20min
MEETING_LINK=https://meet.google.com/xxx-xxxx-xxx
OPT_OUT_LINE=관련 없으시면 "괜찮습니다"라고만 답장 주세요. 더 연락드리지 않겠습니다.

# --- 메일 (Gmail: 2단계 인증 켜고 앱 비밀번호 발급) ---------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=min@shipfast.io
SMTP_PASSWORD=앱비밀번호16자리
IMAP_HOST=imap.gmail.com
SEND_CALENDAR_INVITES=true
DAILY_SEND_LIMIT=40

# --- 일정 -------------------------------------------------------------------
TIMEZONE=Asia/Seoul
FOLLOWUP_INTERVALS=3,4
CALL_AFTER_DAYS=2
FOLLOWUP_TIME=09:00
DAILY_REPORT_TIME=18:00
WORKDAYS=mon-fri

# --- Slack ------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_CHANNEL_ID=C0123456789

# --- 저장소와 대시보드 --------------------------------------------------------
DB_PATH=sales.db
# 서버에 배포하면 대시보드가 인터넷에 열리므로 반드시 긴 비밀번호를 넣으세요.
DASHBOARD_TOKEN=
